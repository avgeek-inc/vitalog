AUTH_KEY=replace-with-an-operator-supplied-secret-of-at-least-32-random-bytes
# Optional, but both must be configured to enable API key generation.
ROOT_EMAIL=
ROOT_PASSWORD=
DATABASE_URL=postgresql://vitalog:replace-password@localhost:5432/vitalog
DEFAULT_TIMEZONE=Asia/Kolkata
PORT=3000
NODE_ENV=production
ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
# OAuth issuer. Inferred when ALLOWED_HOSTS contains exactly one public DNS host.
PUBLIC_BASE_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=
# Browser UI origin trusted only for API-key creation and OAuth consent.
UI_BASE_URL=http://127.0.0.1:3001
# Public API origin provided at runtime to the separate Next.js app.
API_BASE_URL=http://127.0.0.1:3000
UI_PORT=3001
TRUST_PROXY=false
POSTGRES_PASSWORD=replace-with-a-database-password
