AUTH_KEY=replace-with-an-operator-supplied-secret-of-at-least-32-random-bytes
# Optional, but both must be configured to enable API key generation and UI/MCP sign-in.
ROOT_EMAIL=
ROOT_PASSWORD=
DATABASE_URL=postgresql://vitalog:replace-password@localhost:5432/vitalog
PORT=3000
NODE_ENV=production
# Public API origin. Its host and local readiness hosts are accepted automatically.
PUBLIC_BASE_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=
# Optional pre-registered OAuth clients as a JSON array; see docs/oauth.md.
OAUTH_CLIENTS=[]
# Browser UI origin trusted for API-key creation, UI sessions and OAuth consent.
UI_BASE_URL=http://127.0.0.1:3001
# Public API origin provided at runtime to the separate Next.js app.
API_BASE_URL=http://127.0.0.1:3000
# Optional hosted Mintlify origin; Documentation and MCP Guide fall back to the repository until set.
# DOCS_BASE_URL=https://www.vitalog.dev
UI_PORT=3001
POSTGRES_PASSWORD=replace-with-a-database-password
# Optional private S3-compatible attachment storage; all credential fields are required when S3_BUCKET is set.
# Endpoint must be reachable by clients for signed uploads and downloads. Omit it for AWS S3.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
S3_PREFIX=vitalog
