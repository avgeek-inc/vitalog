{
  "name": "vitalog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "predev": "npm run build:web",
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/main.ts",
    "dev:web": "vite build --watch",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "vite build",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "docs:generate": "tsx scripts/generate.ts",
    "docs:check": "tsx scripts/generate.ts --check",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "test:security": "tsx scripts/security-verification.ts",
    "test:auth": "tsx scripts/auth-verification.ts",
    "test:oauth": "tsx scripts/oauth-verification.ts",
    "plugin:package": "tsx scripts/package-plugin.ts",
    "test:summaries": "tsx scripts/summary-verification.ts",
    "test:container": "tsx scripts/container-smoke.ts",
    "test:towbar": "tsx scripts/container-smoke.ts --towbar",
    "towbar:check": "tsx scripts/validate-towbar.ts",
    "verify": "npm run typecheck && npm run build:web && npm run test && npm run docs:check && npm run towbar:check && npm run plugin:package && npm run format:check",
    "operator:export": "node --env-file-if-exists=.env --import tsx scripts/export.ts",
    "operator:erase": "node --env-file-if-exists=.env --import tsx scripts/erase.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.4",
    "@types/node": "24.10.13",
    "@types/pg": "8.16.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.2.4",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
