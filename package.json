{
  "name": "vitalog",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/main.ts",
    "dev:web": "npm run dev --workspace @vitalog/web",
    "build": "npm run build:api && npm run build:web",
    "build:web": "node --run typecheck:web && node --max-old-space-size=512 node_modules/next/dist/bin/next build apps/web --webpack",
    "typecheck:web": "node node_modules/next/dist/bin/next typegen apps/web && node --max-old-space-size=448 node_modules/typescript/bin/tsc --noEmit -p apps/web/tsconfig.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @vitalog/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "docs:generate": "tsx scripts/generate.ts && tsx scripts/mintlify.ts && oss-docs sync --config docs/site.json --dir docs",
    "docs:check": "tsx scripts/generate.ts --check && tsx scripts/mintlify.ts --check && oss-docs check --config docs/site.json --dir docs",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "test:security": "tsx scripts/security-verification.ts",
    "test:auth": "tsx scripts/auth-verification.ts",
    "test:oauth": "tsx scripts/oauth-verification.ts",
    "plugin:package": "tsx scripts/package-plugin.ts",
    "test:summaries": "tsx scripts/summary-verification.ts",
    "test:goals": "tsx scripts/goals-verification.ts",
    "test:web": "tsx scripts/web-verification.ts",
    "preview:web": "npm run build:web && tsx scripts/web-verification.ts --preview",
    "test:container": "tsx scripts/container-smoke.ts",
    "test:towbar": "tsx scripts/container-smoke.ts --towbar",
    "towbar:check": "tsx scripts/validate-towbar.ts",
    "verify": "npm run typecheck && npm run build:web && npm run test && npm run docs:check && npm run towbar:check && npm run plugin:package && npm run format:check",
    "operator:export": "node --env-file-if-exists=.env --import tsx scripts/export.ts",
    "operator:erase": "node --env-file-if-exists=.env --import tsx scripts/erase.ts",
    "build:api": "tsc --noCheck -p tsconfig.build.json",
    "start:web": "npm run start --workspace @vitalog/web",
    "test:build-budget": "tsx scripts/build-budget-verification.ts",
    "docs:site:check": "npm run docs:check && cd docs && npx --yes mint@4.2.986 validate && npx --yes mint@4.2.986 broken-links",
    "docs:dev": "npm run docs:generate && cd docs && npx --yes mint@4.2.986 dev --port 4175",
    "test:attachments": "tsx scripts/attachments-verification.ts",
    "operator:attachments:prune": "node --env-file-if-exists=.env --import tsx scripts/attachments-prune.ts",
    "docs:screenshots": "tsx scripts/capture-docs-screenshots.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.3",
    "file-type": "22.1.1",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@avgeek-oss/design-system": "file:vendor/avgeek-oss-design-system-1.2.10.tgz",
    "@avgeek-oss/docs": "github:avgeek-oss/oss-docs#704cfbb6b952257e0b9d6a2ec0ec4bd66527475d",
    "@types/node": "24.10.13",
    "@types/pg": "8.16.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "prettier": "3.9.9",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "workspaces": [
    "apps/web"
  ]
}
