{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Vitalog",
  "description": "Your health observations, with a read-only dashboard, REST API and MCP.",
  "logo": {
    "light": "/assets/vitalog-mark.png",
    "dark": "/assets/vitalog-mark.png",
    "href": "/"
  },
  "favicon": "/assets/vitalog-favicon.png",
  "colors": { "primary": "#be243c", "light": "#be243c", "dark": "#e33646" },
  "appearance": { "default": "system" },
  "icons": { "library": "lucide" },
  "styling": { "eyebrows": "breadcrumbs", "codeblocks": "system" },
  "interaction": { "drilldown": false },
  "api": { "playground": { "display": "simple" } },
  "navigation": {
    "dropdowns": [
      {
        "dropdown": "Introduction",
        "icon": "book-open",
        "groups": [{ "group": "Get started", "pages": ["index", "quickstart"] }]
      },
      {
        "dropdown": "Using Vitalog",
        "icon": "heart",
        "groups": [
          {
            "group": "Your health ledger",
            "pages": ["dashboard", "goals", "records"]
          }
        ]
      },
      {
        "dropdown": "API and MCP",
        "icon": "plug",
        "groups": [
          {
            "group": "Connect a client",
            "pages": ["mcp-guide", "api-keys", "oauth", "mcp-tools"]
          }
        ]
      },
      {
        "dropdown": "API reference",
        "icon": "code",
        "openapi": "openapi.json"
      },
      {
        "dropdown": "Self-hosting",
        "icon": "server",
        "groups": [
          {
            "group": "Install and configure",
            "pages": ["installation", "configuration", "towbar"]
          },
          {
            "group": "Operate Vitalog",
            "pages": ["operations", "troubleshooting"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      { "type": "github", "href": "https://github.com/avgeek-inc/vitalog" }
    ],
    "primary": {
      "type": "button",
      "label": "Open Vitalog",
      "href": "https://vitalog.praveent.com"
    }
  },
  "footer": {
    "socials": { "github": "https://github.com/avgeek-inc/vitalog" },
    "links": [
      {
        "header": "Documentation",
        "items": [
          { "label": "Connect MCP", "href": "/mcp-guide" },
          { "label": "Install Vitalog", "href": "/installation" },
          { "label": "Goals", "href": "/goals" }
        ]
      },
      {
        "header": "Avgeek, Inc.",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/avgeek-inc/vitalog"
          },
          { "label": "Operations and security", "href": "/operations" }
        ]
      }
    ]
  },
  "contextual": { "options": ["copy", "view", "chatgpt", "claude"] }
}
